{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist/ramplas-system/browser"
            }
        }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "dist/ramplas-system/browser",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}