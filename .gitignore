# IMPORTANTE: Seguridad y Credenciales
# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ NUNCA subir archivos con credenciales reales al repositorio
# ⚠️ Los archivos de environment con credenciales reales deben estar aquí

# Descomentar estas líneas si tienes credenciales reales en environment
# src/environments/environment.ts
# src/environments/environment.prod.ts

# Archivos de configuración local con credenciales
*.local.ts
*.secret.*
.env
.env.local
.env.production

